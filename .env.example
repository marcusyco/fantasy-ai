# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-only, never expose to the client. Used by
# webhooks/cron routes which run without a logged-in Supabase Auth user.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Vercel AI Gateway ────────────────────────────────────────────────────
# Dashboard → AI Gateway → API Keys. Not needed if this app is deployed on
# Vercel and you use OIDC auth instead (see lib/ai/gateway.ts).
AI_GATEWAY_API_KEY=

# Model routing (provider/model strings the AI Gateway understands)
AI_GATEWAY_PRIMARY_MODEL=anthropic/claude-opus-5
AI_GATEWAY_FALLBACK_MODEL=openai/gpt-5.6-sol

# ── Linq (iMessage/RCS/SMS API) ─────────────────────────────────────────
# dashboard.linqapp.com/api-tooling → API → Overview → Generate new token
LINQ_API_KEY=
# The phone number/line (E.164) this app sends iMessages from, provisioned
# in the Linq dashboard.
LINQ_FROM_NUMBER=+1XXXXXXXXXX
# Webhook Subscriptions API → signing secret, format "whsec_..."
LINQ_WEBHOOK_SECRET=whsec_

# ── Yahoo Fantasy Sports API ────────────────────────────────────────────
# developer.yahoo.com app → Fantasy Sports (Read) scope, OAuth2 app type
# "Confidential Client" / "Web Application"
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must exactly match the callback registered with Yahoo, including scheme.
YAHOO_REDIRECT_URI=https://your-app.vercel.app/api/yahoo/callback

# ── App ──────────────────────────────────────────────────────────────────
# Public base URL of this deployment, used to build the Yahoo OAuth
# redirect and any links sent in iMessages.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Shared secret required as a query param on manually-triggered cron routes
# during local testing, e.g. /api/cron/sync-leagues?secret=...
CRON_SECRET=
